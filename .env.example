SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
USE_X_FORWARDED_PROTO=0
USE_X_FORWARDED_HOST=0
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0
# Yerel SQLite kullanmak için DATABASE_URL değerini boş bırakın.
# DATABASE_URL=postgresql://postgres:parola@localhost:5432/gymflow
DB_SSLMODE=prefer
ALLOW_SQLITE_IN_PRODUCTION=0
PORTFOLIO_DEMO_USERNAME=demo-admin
PORTFOLIO_DEMO_PASSWORD=change-me
PORTFOLIO_DEMO_EMAIL=demo@gymflow.local
PORTFOLIO_DEMO_MEMBER_COUNT=160
PORTFOLIO_DEMO_RESET_ON_LOGIN=0
PORTFOLIO_DEMO_RESET_ALL_DATA=0
PORTFOLIO_DEMO_PRESERVE_PLANS=1
